{
  "name": "MarchéIvoire - Marketplace Ivoirienne",
  "short_name": "MarchéIvoire",
  "description": "Marketplace ivoirienne en ligne - Achetez et vendez des produits locaux avec paiement Mobile Money",
  "version": "1.0.0",
  "manifest_version": 3,
  
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "theme_color": "#FF6B35",
  "background_color": "#FFFFFF",
  
  "icons": [
    {
      "src": "assets/images/logo-72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logo-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logo-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logo-144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logo-152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logo-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/images/logo-384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/images/logo-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  
  "screenshots": [
    {
      "src": "assets/images/screenshot-mobile-1.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Page d'accueil mobile"
    },
    {
      "src": "assets/images/screenshot-mobile-2.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Catalogue de produits mobile"
    },
    {
      "src": "assets/images/screenshot-desktop-1.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Page d'accueil desktop"
    },
    {
      "src": "assets/images/screenshot-desktop-2.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Catalogue de produits desktop"
    }
  ],
  
  "categories": [
    "shopping",
    "business",
    "lifestyle",
    "food"
  ],
  
  "lang": "fr",
  "dir": "ltr",
  
  "shortcuts": [
    {
      "name": "Voir les produits",
      "short_name": "Produits",
      "description": "Parcourir le catalogue de produits",
      "url": "/#produits",
      "icons": [
        {
          "src": "assets/images/shortcut-products.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mon panier",
      "short_name": "Panier",
      "description": "Voir mon panier d'achats",
      "url": "/checkout.html",
      "icons": [
        {
          "src": "assets/images/shortcut-cart.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Catégories",
      "short_name": "Catégories",
      "description": "Explorer les catégories de produits",
      "url": "/#categories",
      "icons": [
        {
          "src": "assets/images/shortcut-categories.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  
  "protocol_handlers": [
    {
      "protocol": "web+marcheiivoire",
      "url": "/handle-protocol?product=%s"
    }
  ],
  
  "file_handlers": [
    {
      "action": "/handle-file",
      "accept": {
        "application/json": [".json"],
        "text/csv": [".csv"]
      }
    }
  ],
  
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "handle_links": "preferred",
  
  "id": "marcheiivoire-pwa",
  
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.marcheiivoire.app",
      "id": "com.marcheiivoire.app"
    },
    {
      "platform": "ios",
      "url": "https://apps.apple.com/app/marcheiivoire/id123456789"
    }
  ],
  
  "prefer_related_applications": false,
  
  "iarc_rating_id": "e84b072d-71b3-4d3e-86ae-31a8ce4e53b7"
}